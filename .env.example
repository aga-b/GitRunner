GITHUB_OWNER=aga-b
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_APP_KEY_FILE=/run/secrets/github-app.pem
POOL_NAME=agah-ci
MAX_RUNNERS=20
MAX_RUNNERS_PER_REPO=12
# Poll fast while work exists; slow when idle. ETag-cached requests are cheap.
POLL_SECONDS=10
POLL_IDLE_SECONDS=20
SWEEP_SECONDS=120
PARALLELISM=8
REPO_REFRESH_SECONDS=300
IDLE_TIMEOUT_SECONDS=300
MAX_LIFETIME_SECONDS=10800
LOG_RETENTION_DAYS=7
RUNNER_LABELS=self-hosted,linux,x64,ci-linux
REQUIRED_LABEL=ci-linux
ALLOWED_ACTORS=aga-b
# Blank include list discovers all owned repositories visible to the App.
INCLUDE_REPOS=
EXCLUDE_REPOS=
# Limits are caps, not reservations: measured jobs use ~1 core / <1 GiB on average.
# Memory admission stops new runners when MemAvailable would drop below
# MIN_FREE_MEMORY_MB; each idle runner is assumed to need JOB_MEMORY_RESERVE_MB.
RUNNER_MEMORY=8g
RUNNER_CPUS=8
DIND_MEMORY=4g
DIND_CPUS=4
MIN_FREE_MEMORY_MB=6144
JOB_MEMORY_RESERVE_MB=2048
# Pull-through Docker Hub cache (compose service `mirror`); blank disables it.
DOCKER_MIRROR=http://personal-ci-mirror:5000
DOCKER_MIRROR_NETWORK=personal-ci-mirror
# Shared Playwright browser cache volume; blank disables it.
PLAYWRIGHT_CACHE_VOLUME=personal-ci-playwright
RUNNER_IMAGE=personal-ci-runner:local
# Filled by scripts/build.sh with registry digest, never guessed here.
DIND_IMAGE=
RUNNER_BASE=
