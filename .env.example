GITHUB_OWNER=aga-b
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_APP_KEY_FILE=/run/secrets/github-app.pem
POOL_NAME=agah-ci
MAX_RUNNERS=2
MAX_RUNNERS_PER_REPO=4
POLL_SECONDS=30
REPO_REFRESH_SECONDS=300
IDLE_TIMEOUT_SECONDS=600
MAX_LIFETIME_SECONDS=10800
LOG_RETENTION_DAYS=7
RUNNER_LABELS=self-hosted,linux,x64,ci-linux
REQUIRED_LABEL=ci-linux
ALLOWED_ACTORS=aga-b
# Blank include list discovers all owned repositories visible to the App.
INCLUDE_REPOS=
EXCLUDE_REPOS=
# Production host has 4 vCPU / 15 GiB RAM. Two concurrent jobs reserve up to
# 12 GiB; keep the remaining memory for the host, controller and page cache.
RUNNER_MEMORY=4g
RUNNER_CPUS=2
DIND_MEMORY=2g
DIND_CPUS=1
RUNNER_IMAGE=personal-ci-runner:local
# Filled by scripts/build.sh with registry digest, never guessed here.
DIND_IMAGE=
RUNNER_BASE=
